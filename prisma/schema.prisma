// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum RoomRole {
  HOST
  MEMBER
}

enum PlaybackStatus {
  STOPPED
  PLAYING
  PAUSED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens   RefreshToken[]
  hostedRooms     Room[]
  roomMemberships RoomMember[]
  messages        Message[]
  tracks          Track[]
  queueEntries    RoomQueueEntry[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Room {
  id              String         @id @default(uuid())
  code            String         @unique
  hostId          String         @map("host_id")
  name            String?
  passwordHash    String?        @map("password_hash")
  visibility      RoomVisibility
  maxParticipants Int            @map("max_participants")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  host            User             @relation(fields: [hostId], references: [id])
  members         RoomMember[]
  messages        Message[]
  playback_states PlaybackState[]
  queueEntries    RoomQueueEntry[]

  @@map("rooms")
}

model RoomMember {
  id       String    @id @default(uuid())
  roomId   String    @map("room_id")
  userId   String    @map("user_id")
  role     RoomRole
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@map("room_members")
}

model Message {
  id        String    @id @default(uuid())
  roomId    String    @map("room_id")
  userId    String    @map("user_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("messages")
}

model PlaybackState {
  id          String         @id @default(uuid())
  roomId      String         @unique @map("room_id")
  trackId     String?        @map("track_id")
  status      PlaybackStatus @default(STOPPED)
  positionMs  Int            @default(0) @map("position_ms")
  scheduledAt DateTime?      @map("scheduled_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  room Room @relation(fields: [roomId], references: [id])

  @@map("playback_states")
}

model Track {
  id         String   @id @default(uuid())
  ownerId    String   @map("owner_id")
  title      String
  storageKey String   @unique @map("storage_key")
  durationMs Int      @map("duration_ms")
  mimeType   String   @map("mime_type")
  size       Int
  createdAt  DateTime @default(now()) @map("created_at")

  owner        User             @relation(fields: [ownerId], references: [id])
  queueEntries RoomQueueEntry[]

  @@map("tracks")
}

model RoomQueueEntry {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  trackId   String   @map("track_id")
  addedById String   @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  room    Room  @relation(fields: [roomId], references: [id])
  track   Track @relation(fields: [trackId], references: [id])
  addedBy User  @relation(fields: [addedById], references: [id])

  @@map("room_queue_entries")
}
